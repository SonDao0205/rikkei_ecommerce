# Local development values only. Replace all passwords and JWT_SECRET before shared or production use.
DB_HOST=mysql
DB_USERNAME=ecommerce_user
DB_PASSWORD=local-dev-only-change-this
DB_NAME=rikkei_ecommerce
MYSQL_ROOT_PASSWORD=change_root_password
TUNNEL_TOKEN=

APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
OTP_TTL=10m
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set this to the exact frontend/Nginx container IP or CIDR on the Docker network.
TRUSTED_PROXY_CIDRS=172.22.0.3/32
COOKIE_SECURE=false
AUTO_MIGRATE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

VITE_API_BASE_URL=
VITE_BACKEND_HOST=http://localhost:8080
VITE_APP_NAME=MarketPulse
VITE_APP_ENV=development
VITE_DEFAULT_AVATAR_SERVICE_URL=https://ui-avatars.com/api/
VITE_SUPPORT_HOTLINE="+84 1900 6868"
VITE_SUPPORT_EMAIL=support@marketpulse.vn
