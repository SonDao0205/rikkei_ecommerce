{
  "info": {
    "_postman_id": "548fb440-44a7-4a2d-b59e-41bec88e8f20",
    "name": "Rikkei E-Commerce API",
    "description": "Local API collection for the implemented Rikkei E-Commerce backend routes. Run only against a local/test database. Run database/seed-local.ps1 first; the collection registers disposable users and mutates the dedicated product 960009.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:18080" },
    { "key": "seedPassword", "value": "LocalTest123!" },
    { "key": "shopId", "value": "920001" },
    { "key": "productId", "value": "960001" },
    { "key": "adminTestProductId", "value": "960009" },
    { "key": "categoryId", "value": "930005" },
    { "key": "brandId", "value": "940003" },
    { "key": "clientToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "sellerToken", "value": "" },
    { "key": "resetOtp", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/healthz"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API and database are healthy', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Public Catalog and Shops",
      "item": [
        {
          "name": "List active categories",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/categories" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Returns active categories and All entry', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json().data;",
              "  pm.expect(data).to.be.an('array');",
              "  pm.expect(data[0].id).to.eql(0);",
              "});"
            ]}
          }]
        },
        {
          "name": "Reject unexpected category query",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/categories?unexpected=1" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Rejects unknown query parameters', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().errors[0].code).to.eql('invalid_query');",
              "});"
            ]}
          }]
        },
        {
          "name": "List products with pagination",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/products?page=1&limit=20&sort=latest" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Returns a paginated catalog response', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json().data;",
              "  pm.expect(data.products).to.be.an('array');",
              "  pm.expect(data.page).to.eql(1);",
              "  pm.expect(data.limit).to.eql(20);",
              "});"
            ]}
          }]
        },
        {
          "name": "Search products by non-adjacent name tokens",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/products?q=iphone%20pro%20max&page=1&limit=20" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Matches and ranks products by name-token coverage', function () {",
              "  pm.response.to.have.status(200);",
              "  const products = pm.response.json().data.products;",
              "  const ids = products.map(function (product) { return product.id; });",
              "  pm.expect(ids.length).to.be.at.least(3);",
              "  pm.expect([960004, 960007]).to.include(ids[0]);",
              "  pm.expect([960004, 960007]).to.include(ids[1]);",
              "  pm.expect(ids[2]).to.eql(960005);",
              "});"
            ]}
          }]
        },
        {
          "name": "Filter products by category, brand, price and rating",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/products?q=cotton&category_id=930002&brand_id=940001&min_price=100000&max_price=300000&min_rating=4.5&sort=price_asc&page=1&limit=10" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Applies catalog filters and sort', function () {",
              "  pm.response.to.have.status(200);",
              "  const products = pm.response.json().data.products;",
              "  pm.expect(products.length).to.be.at.least(1);",
              "  pm.expect(products[0].id).to.eql(960001);",
              "});"
            ]}
          }]
        },
        {
          "name": "Reject invalid catalog filters",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/products?page=0" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Rejects invalid pagination input', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().errors[0].code).to.eql('invalid_product_filters');",
              "});"
            ]}
          }]
        },
        {
          "name": "Product detail",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/products/{{productId}}" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Returns product, images, active variants and public shop', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json().data;",
              "  pm.expect(data.product.id).to.eql(Number(pm.collectionVariables.get('productId')));",
              "  pm.expect(data.images).to.be.an('array');",
              "  pm.expect(data.variants).to.be.an('array');",
              "  pm.expect(data.shop).to.have.property('id');",
              "  pm.expect(data.shop).not.to.have.property('warehouse_address');",
              "});"
            ]}
          }]
        },
        {
          "name": "Reject unavailable product detail",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/products/960003" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Does not expose an unapproved product', function () {",
              "  pm.response.to.have.status(404);",
              "});"
            ]}
          }]
        },
        {
          "name": "Reject invalid product ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/products/not-an-id" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Rejects malformed product IDs', function () {",
              "  pm.response.to.have.status(400);",
              "});"
            ]}
          }]
        },
        {
          "name": "Shop detail",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/shops/{{shopId}}" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Returns only public shop fields', function () {",
              "  pm.response.to.have.status(200);",
              "  const shop = pm.response.json().data.shop;",
              "  pm.expect(shop.id).to.eql(Number(pm.collectionVariables.get('shopId')));",
              "  pm.expect(shop).not.to.have.property('warehouse_address');",
              "  pm.expect(shop).not.to.have.property('owner_id');",
              "});"
            ]}
          }]
        },
        {
          "name": "Shop product listing",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/shops/{{shopId}}/products?page=1&limit=10" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Returns products from the requested active shop', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json().data;",
              "  pm.expect(data.products).to.be.an('array');",
              "  pm.expect(data.products.length).to.be.at.least(1);",
              "});"
            ]}
          }]
        },
        {
          "name": "Reject query parameters on shop detail",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/shops/{{shopId}}?debug=1" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Rejects unsupported shop detail query parameters', function () {",
              "  pm.response.to.have.status(400);",
              "});"
            ]}
          }]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register disposable CLIENT",
          "event": [{
            "listen": "prerequest",
            "script": { "type": "text/javascript", "exec": [
              "const runId = Date.now().toString() + Math.floor(Math.random() * 100000).toString().padStart(5, '0');",
              "pm.collectionVariables.set('runId', runId);",
              "pm.collectionVariables.set('testEmail', 'postman-' + runId + '@example.test');",
              "pm.collectionVariables.set('testPhone', '+849' + runId.slice(-9));",
              "pm.collectionVariables.set('testPassword', 'PostmanTest123!');",
              "pm.environment.set('testEmail', 'postman-' + runId + '@example.test');",
              "pm.environment.set('testPassword', 'PostmanTest123!');"
            ]}
          }, {
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Creates a CLIENT account with valid input', function () {",
              "  pm.response.to.have.status(201);",
              "  const user = pm.response.json().data;",
              "  pm.expect(user.email).to.eql(pm.collectionVariables.get('testEmail'));",
              "  pm.expect(user.role).to.eql('CLIENT');",
              "  pm.collectionVariables.set('clientId', String(user.id));",
              "});"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"full_name\": \"Postman API Test\",\n  \"phone\": \"{{testPhone}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Reject duplicate registration",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"full_name\": \"Postman API Test\",\n  \"phone\": \"{{testPhone}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/register"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Returns conflict for duplicate account data', function () {",
              "  pm.response.to.have.status(409);",
              "  pm.expect(pm.response.json().errors[0].code).to.eql('account_exists');",
              "});"
            ]}
          }]
        },
        {
          "name": "Reject weak registration password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"invalid-{{runId}}@example.test\",\n  \"password\": \"weak\",\n  \"full_name\": \"Invalid User\",\n  \"phone\": \"+84912345678\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/register"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Rejects weak passwords', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().errors[0].code).to.eql('weak_password');",
              "});"
            ]}
          }]
        },
        {
          "name": "Login disposable CLIENT",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Logs in and sets an HttpOnly refresh cookie', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json().data;",
              "  pm.expect(data.access_token).to.be.a('string');",
              "  pm.expect(data.token_type).to.eql('Bearer');",
              "  pm.expect(pm.response.headers.get('Set-Cookie')).to.include('HttpOnly');",
              "  pm.collectionVariables.set('clientToken', data.access_token);",
              "});"
            ]}
          }]
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/auth/me"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Returns authenticated profile', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.email).to.eql(pm.collectionVariables.get('testEmail'));",
              "});"
            ]}
          }]
        },
        {
          "name": "Update current profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clientToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Postman Profile Updated\",\n  \"phone\": \"{{testPhone}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/profile"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Updates the current user profile', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.full_name).to.eql('Postman Profile Updated');",
              "});"
            ]}
          }]
        },
        {
          "name": "Reject invalid login credentials",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{testEmail}}\",\n  \"password\": \"wrong-password\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Rejects invalid credentials without leaking account details', function () {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json().errors[0].code).to.eql('invalid_credentials');",
              "});"
            ]}
          }]
        },
        {
          "name": "Request password reset OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{testEmail}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/forgot-password"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Returns the same generic response for password recovery', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().message).to.include('If the account exists');",
              "});"
            ]}
          }]
        },
        {
          "name": "Reject malformed reset OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{testEmail}}\",\n  \"otp\": \"abcdef\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/verify-reset-otp"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Rejects malformed OTP values', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().errors[0].code).to.eql('invalid_or_expired_otp');",
              "});"
            ]}
          }]
        },
        {
          "name": "Refresh access token",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/auth/refresh" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Rotates refresh cookie and issues a new access token', function () {",
              "  pm.response.to.have.status(200);",
              "  const token = pm.response.json().data.access_token;",
              "  pm.expect(token).to.be.a('string');",
              "  pm.collectionVariables.set('clientToken', token);",
              "});"
            ]}
          }]
        },
        {
          "name": "Change password",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clientToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"current_password\": \"{{testPassword}}\",\n  \"new_password\": \"ChangedPass123!\",\n  \"confirm_password\": \"ChangedPass123!\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/password"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Changes password and invalidates sessions', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.collectionVariables.set('testPassword', 'ChangedPass123!');",
              "pm.environment.set('testPassword', 'ChangedPass123!');"
            ]}
          }]
        },
        {
          "name": "Reject login with old password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{testEmail}}\",\n  \"password\": \"PostmanTest123!\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Old password no longer authenticates', function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]}
          }]
        },
        {
          "name": "Login with changed password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('New password authenticates', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.collectionVariables.set('clientToken', pm.response.json().data.access_token);",
              "});"
            ]}
          }]
        }
      ]
    },
    {
      "name": "Client Shop Follow",
      "item": [
        {
          "name": "Read follow state",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/shops/{{shopId}}/follow"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('CLIENT can read follow state', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.following).to.be.a('boolean');",
              "});"
            ]}
          }]
        },
        {
          "name": "Follow shop",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/shops/{{shopId}}/follow"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Follows shop and reports updated count', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.following).to.eql(true);",
              "  pm.collectionVariables.set('followCount', String(pm.response.json().data.follower_count));",
              "});"
            ]}
          }]
        },
        {
          "name": "Follow shop again (idempotent)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/shops/{{shopId}}/follow"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Repeated follow does not increment follower count', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(String(pm.response.json().data.follower_count)).to.eql(pm.collectionVariables.get('followCount'));",
              "});"
            ]}
          }]
        },
        {
          "name": "Unfollow shop",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/shops/{{shopId}}/follow"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Unfollows shop', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.following).to.eql(false);",
              "  pm.collectionVariables.set('unfollowCount', String(pm.response.json().data.follower_count));",
              "});"
            ]}
          }]
        },
        {
          "name": "Unfollow shop again (idempotent)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/shops/{{shopId}}/follow"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Repeated unfollow does not decrement follower count', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(String(pm.response.json().data.follower_count)).to.eql(pm.collectionVariables.get('unfollowCount'));",
              "});"
            ]}
          }]
        },
        {
          "name": "Reject CLIENT access to admin inventory",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/products"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('CLIENT cannot access admin inventory', function () {",
              "  pm.response.to.have.status(403);",
              "});"
            ]}
          }]
        },
        {
          "name": "Logout disposable CLIENT",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/auth/logout"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Revokes the current session', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]}
          }]
        },
        {
          "name": "Reject protected request after logout",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/auth/me"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Revoked access session cannot be reused', function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]}
          }]
        }
      ]
    },
    {
