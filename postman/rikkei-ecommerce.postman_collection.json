    {
      "name": "Manual Password Reset (requires OTP)",
      "description": "Optional manual flow only. First send Request password reset OTP in Authentication, read the development OTP from docker compose logs backend, set resetOtp in the selected Postman environment, then run these requests. A successful reset invalidates sessions and changes the disposable user password.",
      "item": [
        {
          "name": "Verify valid reset OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{testEmail}}\",\n  \"otp\": \"{{resetOtp}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/verify-reset-otp"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!(pm.environment.get('resetOtp') || pm.collectionVariables.get('resetOtp'))) {",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Verifies a valid reset OTP', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset password with valid OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{testEmail}}\",\n  \"otp\": \"{{resetOtp}}\",\n  \"new_password\": \"PostmanReset123!\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/reset-password"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!(pm.environment.get('resetOtp') || pm.collectionVariables.get('resetOtp'))) {",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Resets password using a valid OTP', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
